<Window x:Class="MinimalPomodoro.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Icon="Assets/app.ico"
        Width="548"
        Height="576"
        MinWidth="548"
        MinHeight="576"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Grid Margin="14">
    <Border CornerRadius="18"
            Background="#FFFFFF"
            Opacity="0.45"
            Margin="0,5,0,-1"
            IsHitTestVisible="False">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Opacity="0.20" Color="#1F2937" />
        </Border.Effect>
    </Border>
    <Border Style="{StaticResource WindowChromeBorderStyle}"
            MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Height="34"
                Background="{StaticResource TitleBarBrush}"
                BorderBrush="#E7EBF1"
                BorderThickness="0,0,0,1"
                CornerRadius="18,18,0,0" />

        <Grid Grid.Row="0" Margin="16,0" Height="34">
            <Button x:Name="CloseButton"
                    Style="{StaticResource MacCloseButtonStyle}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="CloseButton_Click" />
            <TextBlock Text="设置"
                       Style="{StaticResource TitleBarTextStyle}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="26,8,26,12">
            <TextBlock Text="番茄钟" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock x:Name="TodayCountText" Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="18,0,18,10" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                <Border CornerRadius="14"
                        Background="#FFFFFF"
                        Margin="0,2,0,-1"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#000000" />
                    </Border.Effect>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <StackPanel>
                        <Grid Margin="18,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="专注时长" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="每个番茄的默认持续时间" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBox x:Name="FocusMinutesBox" />
                                <TextBlock Text="分钟" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            </DockPanel>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrushSubtle}" Margin="18,0" />

                        <Grid Margin="18,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="短休息" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="专注结束后的普通休息时长" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBox x:Name="ShortBreakMinutesBox" />
                                <TextBlock Text="分钟" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            </DockPanel>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrushSubtle}" Margin="18,0" />

                        <Grid Margin="18,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="长休息" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="完成几轮后进入更长的休息" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="LongBreakMinutesBox" Width="60" />
                                <TextBlock Text="分钟 / 每" Margin="7,0,7,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox x:Name="LongBreakIntervalBox" Width="52" />
                                <TextBlock Text="轮" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                </Grid>

                <Grid>
                <Border CornerRadius="14"
                        Background="#FFFFFF"
                        Margin="0,2,0,-1"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#000000" />
                    </Border.Effect>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <StackPanel>
                        <Grid Margin="18,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="通知声音" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="番茄或休息结束时播放系统提示音" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <CheckBox x:Name="SoundCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrushSubtle}" Margin="18,0" />

                        <Grid Margin="18,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="开机自启" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="登录 Windows 后自动常驻托盘" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <CheckBox x:Name="StartupCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                BorderBrush="#E0E6EF"
                BorderThickness="0,1,0,0"
                Padding="22,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F7F9FC" Offset="0" />
                    <GradientStop Color="#EEF2F7" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" MinWidth="96" Click="Cancel_Click" Margin="0,0,14,0" />
                <Button Content="保存" IsDefault="True" MinWidth="96" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
    </Border>
    </Grid>
</Window>
