<Window x:Class="MinimalPomodoro.App.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="番茄钟"
        Icon="Assets/app.ico"
        Width="334"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Grid Margin="14">
    <Border CornerRadius="18"
            Background="#FFFFFF"
            Opacity="0.45"
            Margin="0,5,0,-1"
            IsHitTestVisible="False">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Opacity="0.20" Color="#1F2937" />
        </Border.Effect>
    </Border>
    <Border Style="{StaticResource WindowChromeBorderStyle}"
            MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource TitleBarBrush}"
                    BorderBrush="#E7EBF1"
                    BorderThickness="0,0,0,1"
                    CornerRadius="18,18,0,0" />

            <Grid Grid.Row="0" Margin="16,0">
                <Button x:Name="CloseButton"
                        Style="{StaticResource MacCloseButtonStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="CloseButton_Click" />
                <TextBlock Text="番茄钟"
                           Style="{StaticResource TitleBarTextStyle}" />
            </Grid>

        <Border Margin="14,13,14,14"
                Grid.Row="1"
                Padding="0"
                Background="Transparent"
                BorderThickness="0">
            <Grid>
                <Border CornerRadius="14"
                        Background="#FFFFFF"
                        Margin="0,2,0,-1"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#000000" />
                    </Border.Effect>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}"
                        Padding="18,16,18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="PhaseText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock x:Name="RemainingText" Grid.Row="1" FontSize="44" FontWeight="Light" Margin="0,0,0,0" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="CompletedText" Grid.Row="2" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,0" />
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PrimaryButton" IsDefault="True" MinWidth="104" Click="PrimaryButton_Click" />
                    <Button x:Name="TopmostButton" Grid.Column="2" Content="置顶" Click="TopmostButton_Click" />
                </Grid>
            </Grid>
                </Border>
            </Grid>
        </Border>
        </Grid>
    </Border>
    </Grid>
</Window>
